# Points the app at a locally-run backend (see `./gradlew bootRunLocal` in backend/).
# Expo only loads .env.development files when NODE_ENV=development (i.e. `expo start`/
# `npm run web`), never for `expo export`/production builds (NODE_ENV=production) - unlike
# .env.local, which Expo loads in every mode including production. That's why this file is
# named .env.development and not .env.local: a previous version of this file was named
# .env.local and got silently baked into a production web build, pointing the deployed site
# at localhost. Everything else (Google client IDs, etc.) still comes from the tracked .env.
# Delete or comment out to fall back to the deployed API during local dev.
API_BASE_URL=http://localhost:8080
